	godBtn.Text = State.GodMode and "อมตะ: เปิด" or "อมตะ: ปิด"
	godBtn.BackgroundColor3 = State.GodMode and Color3.fromRGB(30, 140, 200) or Color3.fromRGB(35, 35, 48)
end)

Conn["God"] = RunService.Heartbeat:Connect(function()
	if not State.GodMode then return end
	pcall(function()
		local h = Hum()
		local r = Root()
		if h and h.Health > 0 then h.Health = h.MaxHealth end
		if r and r.Position.Y < -300 then
			r.CFrame = CFrame.new(r.Position.X, 40, r.Position.Z)
		end
	end)
end)

