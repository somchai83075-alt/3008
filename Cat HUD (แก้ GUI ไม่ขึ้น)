local function TP(plr)
	pcall(function()
		local t = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		local m = Root()
		if t and m then
			m.CFrame = t.CFrame * CFrame.new(0, 0, 3)
		end
	end)
end

local function Refresh()
	pcall(function()
		for _, c in pairs(PBox:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, p in pairs(Players:GetPlayers()) do
			if p \~= LocalPlayer then
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, -2, 0, 22)
				b.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
				b.TextColor3 = Color3.new(1, 1, 1)
				b.Font = Enum.Font.Gotham
				b.TextSize = 11
				b.Text = "  " .. p.DisplayName
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.Parent = PBox
				local bc = Instance.new("UICorner")
				bc.CornerRadius = UDim.new(0, 5)
				bc.Parent = b
				b.MouseButton1Click:Connect(function() TP(p) end)
			end
		end
	end)
end

Players.PlayerAdded:Connect(Refresh)
Players.PlayerRemoving:Connect(Refresh)
