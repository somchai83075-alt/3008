local function Dis(name)
	if Conn[name] then
		pcall(function() Conn[name]:Disconnect() end)
		Conn[name] = nil
	end
end

local function Hum()
	local c = LocalPlayer.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function Root()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

