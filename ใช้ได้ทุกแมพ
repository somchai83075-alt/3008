local function TP(plr)
	pcall(function()
		local t = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		local m = Root()
		if t and m then
			m.CFrame = t.CFrame * CFrame.new(0, 0, 3)
		end
	end)
end

local function Refresh()
	pcall(function()
		for _, c in ipairs(PBox:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p \~= LocalPlayer then
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, -2, 0, 22)
				b.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
				b.TextColor3 = Color3.new(1, 1, 1)
				b.Font = Enum.Font.Gotham
				b.TextSize = 11
				b.Text = "  " .. p.DisplayName
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.Parent = PBox
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
				b.MouseButton1Click:Connect(function() TP(p) end)
			end
		end
	end)
end

