local function Give(tool)
	pcall(function()
		if not tool or not tool:IsA("Tool") then return end
		local clone = tool:Clone()
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LocalScript") then
				d.Disabled = false
			end
		end
		local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
		if bp then
			clone.Parent = bp
		elseif LocalPlayer.Character then
			clone.Parent = LocalPlayer.Character
		end
	end)
end

local function LoadItems(filter)
	pcall(function()
		for _, c in ipairs(IScroll:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end

		local added = {}
		local sources = {workspace, ReplicatedStorage, StarterPack}

		for _, src in ipairs(sources) do
			pcall(function()
				for _, v in ipairs(src:GetDescendants()) do
					if v:IsA("Tool") and not added[v.Name] then
						if filter == "" or string.find(string.lower(v.Name), string.lower(filter), 1, true) then
							added[v.Name] = true
							local b = Instance.new("TextButton")
							b.Size = UDim2.new(1, -2, 0, 24)
							b.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
							b.TextColor3 = Color3.new(1, 1, 1)
							b.Font = Enum.Font.Gotham
							b.TextSize = 11
							b.Text = "  " .. v.Name
							b.TextXAlignment = Enum.TextXAlignment.Left
							b.Parent = IScroll
							Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)

							b.MouseButton1Click:Connect(function()
								Give(v)
								b.BackgroundColor3 = Color3.fromRGB(35, 150, 80)
								b.Text = "  ✓ ได้แล้ว"
								task.delay(0.6, function()
									if b and b.Parent then
										b.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
										b.Text = "  " .. v.Name
									end
								end)
							end)
						end
					end
				end
			end)
		end
	end)
end

