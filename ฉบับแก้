local refreshPending = false
local function refreshPlayers()
	if refreshPending then return end
	refreshPending = true
	task.defer(function()
		for _, c in pairs(pFrame:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, p in pairs(Players:GetPlayers()) do
			if p \~= LocalPlayer then
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, -2, 0, 20)
				b.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
				b.TextColor3 = Color3.new(1, 1, 1)
				b.Font = Enum.Font.Gotham
				b.TextSize = 11
				b.Text = "  " .. p.DisplayName
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.Parent = pFrame
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
				b.MouseButton1Click:Connect(function()
					local t = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					local m = getRoot()
					if t and m then
						m.CFrame = t.CFrame * CFrame.new(0, 0, 3)
					end
				end)
			end
		end
		refreshPending = false
	end)
end

addConn(Players.PlayerAdded:Connect(refreshPlayers))
addConn(Players.PlayerRemoving:Connect(refreshPlayers))
refreshPlayers()

