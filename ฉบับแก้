-- ==================== Connection Manager ====================
local connections = {}
local function addConn(conn)
	table.insert(connections, conn)
	return conn
end

-- ==================== Update Loop ====================
local updateTasks = {}
local function registerTask(fn)
	table.insert(updateTasks, fn)
end

addConn(RunService.RenderStepped:Connect(function()
	for _, fn in ipairs(updateTasks) do
		pcall(fn)
	end
end))

-- ==================== STATE ====================
local State = {
	Fly = false,
	God = false,
	Noclip = false,
	InfJump = false,
	Speed = 28,
	FlySpeed = 60
}

local BV, BG
local keys = { Space = false, Shift = false }

local function getHum()
	local c = LocalPlayer.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- ==================== KEY ====================
addConn(UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.Space then keys.Space = true end
	if input.KeyCode == Enum.KeyCode.LeftShift then keys.Shift = true end
end))

addConn(UIS.InputEnded:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.Space then keys.Space = false end
	if input.KeyCode == Enum.KeyCode.LeftShift then keys.Shift = false end
end))

-- ==================== FLY ====================
local function stopFly()
	State.Fly = false
	if BV then pcall(function() BV:Destroy() end) BV = nil end
	if BG then pcall(function() BG:Destroy() end) BG = nil end
	local h = getHum()
	if h then h.PlatformStand = false end
end

local function startFly()
	stopFly()
	local r, h = getRoot(), getHum()
	if not r or not h then return end
	State.Fly = true
	h.PlatformStand = true

	BV = Instance.new("BodyVelocity")
	BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	BV.Velocity = Vector3.new(0, 0, 0)
	BV.Parent = r

	BG = Instance.new("BodyGyro")
	BG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	BG.P = 2000
	BG.Parent = r
end

registerTask(function()
	if not State.Fly then return end
	local root = getRoot()
	local hum = getHum()
	if not root or not hum then
		stopFly()
		return
	end

	local move = Vector3.new(0, 0, 0)
	local dir = hum.MoveDirection
	if dir.Magnitude > 0 then
		local rel = Camera.CFrame:VectorToObjectSpace(dir)
		move = Camera.CFrame.LookVector * -rel.Z + Camera.CFrame.RightVector * rel.X
	end
	if keys.Space then move = move + Vector3.new(0, 1, 0) end
	if keys.Shift then move = move - Vector3.new(0, 1, 0) end

	if move.Magnitude > 0 then
		BV.Velocity = move.Unit * State.FlySpeed
	else
		BV.Velocity = Vector3.new(0, 0, 0)
	end
	BG.CFrame = CFrame.new(root.Position, root.Position + Camera.CFrame.LookVector)
end)

-- ==================== GOD + SPEED ====================
registerTask(function()
	local h = getHum()
	if not h then return end
	if State.God and h.Health > 0 then
		h.Health = h.MaxHealth
	end
	h.WalkSpeed = State.Speed
end)

-- ==================== NOCLIP ====================
local function setNoclip(character, enable)
	if not character then return end
	local names = {"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso"}
	for _, name in ipairs(names) do
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			p.CanCollide = not enable
		end
	end
end

local function startNoclip()
	State.Noclip = true
	setNoclip(LocalPlayer.Character, true)
end

local function stopNoclip()
	State.Noclip = false
	setNoclip(LocalPlayer.Character, false)
end

