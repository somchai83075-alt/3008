-- แสดงตัวเลข (ถ้าเป็น infinity ให้โชว์ ∞)
local function fmt(v)
	if v == math.huge then return "∞" end
	return tostring(math.floor(v))
end

local function setBar(fill, value, max)
	if value == math.huge or max == math.huge then
		fill.Size = UDim2.new(1, 0, 1, 0)
	else
		fill.Size = UDim2.new(math.clamp(value / max, 0, 1), 0, 1, 0)
	end
end

-- อัปเดตเลือด
local function bindHealth(character)
	local hum = character:WaitForChild("Humanoid")
	local function update()
		hpLabel.Text = "เลือด: " .. fmt(hum.Health) .. " / " .. fmt(hum.MaxHealth)
		setBar(hpFill, hum.Health, hum.MaxHealth)
	end
	hum.HealthChanged:Connect(update)
	hum:GetPropertyChangedSignal("MaxHealth"):Connect(update)
	update()
end
player.CharacterAdded:Connect(bindHealth)
if player.Character then bindHealth(player.Character) end

